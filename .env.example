# --- the token ---
# $MOCHI contract on robinhood chain once launched (pons / hood.fun). empty = pre-launch mode:
# epochs still run, votes count 1 per wallet, voters earn PRELAUNCH_RIBBONS per epoch.
TOKEN_CA=
# where "buy" should point. empty = the dexscreener pair once one exists.
BUY_URL=
# robinhood chain rpc. the public one is fine for what she does (single reads).
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- the protocol (after deploying contracts/ with forge script) ---
# MochiVault (mUSD): deposit USDG, routed into spark spUSDG, real yield
VAULT_CA=
# MochiStaking: stake $MOCHI, earn the vault's fee cut in mUSD
STAKING_CA=
# canonical USDG on robinhood chain (paxos)
USDG_CA=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# --- the machine ---
EPOCH_HOURS=4
# ribbons minted per epoch, split pro-rata across holders by balance (live mode)
RIBBONS_PER_EPOCH=1000
# extra ribbons for every wallet that voted (live mode)
VOTER_BONUS=5
# ribbons for every wallet that voted (pre-launch mode)
PRELAUNCH_RIBBONS=10
# minimum token balance (whole tokens) to count as a holder
MIN_HOLD=0
TICK_SEC=30
POST_EVERY_MIN=90

# --- the site ---
SITE_URL=http://localhost:3000
# session cookie signing secret. empty = generated once into data/auth-secret.json
AUTH_SECRET=
# character model: a .vrm you made in vroid studio (public/mochi.vrm) or a live2d .model3.json
NEXT_PUBLIC_CHARACTER_MODEL=/mochi.vrm

# --- x: her voice (free tier posts) ---
X_USERNAME=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# --- x: gifts by tweet (reading mentions needs the basic tier bearer token) ---
X_BEARER_TOKEN=
MENTIONS_EVERY_SEC=60

# --- optional: llm voice for posts (empty = built-in templates) ---
ANTHROPIC_API_KEY=
MOCHI_MODEL=claude-opus-5
